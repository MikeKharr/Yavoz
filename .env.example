# Токен Яндекс.Диска. Получить: https://yandex.ru/dev/disk/poligon/ (кнопка «Получить OAuth-токен»)
YADISK_TOKEN=

# Поисковый API Яндекс Облака.
# Ключ: консоль Yandex Cloud -> сервисный аккаунт -> API-ключ (сервис search-api)
# Каталог: идентификатор каталога (folder) в той же консоли
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=

# Необязательное
YAVOZ_PORT=8765
YAVOZ_MAX_ROWS=0
