# Токен Яндекс.Диска. Получить: https://yandex.ru/dev/disk/poligon/ (кнопка «Получить OAuth-токен»)
YADISK_TOKEN=

# Источник выдачи: ddg (бесплатный, по умолчанию) или yandex (платный).
YAVOZ_SEARCH=ddg

# Нужно ТОЛЬКО при YAVOZ_SEARCH=yandex.
# Поисковый API. Живёт в AI Studio: https://aistudio.yandex.ru
# Ключ: кнопка «Создать API-ключ». Сервисному аккаунту нужна роль
#       search-api.webSearch.user, иначе ответ 403. Нужна привязанная карта.
# Каталог: навести на название каталога вверху экрана -> значок копирования.
# Цена: 0,488 руб. за синхронный запрос днём, 0,366 ночью (00:00-07:59 МСК).
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=

# Необязательное
YAVOZ_PORT=8765
YAVOZ_MAX_ROWS=0
