# Токен Яндекс.Диска. Получить: https://yandex.ru/dev/disk/poligon/ (кнопка «Получить OAuth-токен»)
YADISK_TOKEN=

# Поисковый API. Живёт в AI Studio: https://aistudio.yandex.ru
# Ключ: кнопка «Создать API-ключ» (сервисный аккаунт с нужной ролью
#       создаётся вместе с ключом). Нужен привязанный платёжный аккаунт.
# Каталог: навести на название каталога вверху экрана -> значок копирования.
# Цена: 0,488 руб. за синхронный запрос днём, 0,366 ночью (00:00-07:59 МСК).
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=

# Необязательное
YAVOZ_PORT=8765
YAVOZ_MAX_ROWS=0
